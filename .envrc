PROJECT_PYTHON_VERSION="3.13.7"
VENV_DIR=".venv"

if command -v pyenv >/dev/null 2>&1; then
  export PYENV_VERSION="$PROJECT_PYTHON_VERSION"
fi

PY_BIN=""
if command -v python3 >/dev/null 2>&1; then
  PY_BIN="python3"
elif command -v python >/dev/null 2>&1; then
  PY_BIN="python"
fi

if [ -z "$PY_BIN" ]; then
  echo "Python not found. Install Python $PROJECT_PYTHON_VERSION or set PATH."
  return 1
fi

if ! "$PY_BIN" -c "import sys" >/dev/null 2>&1; then
  if [ -n "${PYENV_VERSION:-}" ]; then
    unset PYENV_VERSION
    if "$PY_BIN" -c "import sys" >/dev/null 2>&1; then
      echo "pyenv version $PROJECT_PYTHON_VERSION not available, using system Python."
    else
      echo "Python not working. Install Python $PROJECT_PYTHON_VERSION."
      return 1
    fi
  else
    echo "Python not working. Install Python $PROJECT_PYTHON_VERSION."
    return 1
  fi
fi

PY_VER="$($PY_BIN -c 'import sys; print(".".join(map(str, sys.version_info[:3])))' 2>/dev/null)"
if [ -n "$PY_VER" ] && [ "$PY_VER" != "$PROJECT_PYTHON_VERSION" ]; then
  echo "Python version $PY_VER in use; expected $PROJECT_PYTHON_VERSION."
  echo "If you use pyenv: pyenv install $PROJECT_PYTHON_VERSION"
fi

if [ ! -d "$VENV_DIR" ]; then
  "$PY_BIN" -m venv "$VENV_DIR"
fi

if [ -f "$VENV_DIR/bin/activate" ]; then
  . "$VENV_DIR/bin/activate"
elif [ -f "$VENV_DIR/Scripts/activate" ]; then
  . "$VENV_DIR/Scripts/activate"
fi
